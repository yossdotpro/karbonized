/**
 * @see https://www.electron.build/configuration/configuration
 */
{
	"appId": "com.yossdotpro.karbonized",
	"publish": {
		"provider": "github",
		"protocol": "https",
		"releaseType": "release"
	},
	"asar": true,
	"directories": {
		"output": "release/${version}"
	},
	"files": ["dist", "dist-electron"],
	"asarUnpack": ["dist-electron/mcp-stdio.cjs"],
	"fileAssociations": [
		{
			"ext": "kproject",
			"name": "Karbonized Project",
			"description": "Karbonized project",
			"mimeType": "application/x-karbonized-project",
			"role": "Editor",
			"icon": "src-electron/assets/file-kproject"
		},
		{
			"ext": "kbrand",
			"name": "Karbonized Brand Kit",
			"description": "Karbonized brand kit",
			"mimeType": "application/x-karbonized-brand",
			"role": "Editor",
			"icon": "src-electron/assets/file-kbrand"
		}
	],
	"mac": {
		"artifactName": "${productName}_${version}.${ext}",
		"target": ["dmg"],
		"icon": "./src-electron/assets/icon.icns"
	},
	"win": {
		"artifactName": "${productName}_${version}.${ext}",
		"target": [
			{
				"target": "nsis",
				"arch": ["x64"]
			}
		],
		"icon": "./src-electron/assets/icon.ico"
	},
	"linux": {
		"target": ["AppImage", "deb", "rpm", "pacman"],
		"icon": "./src-electron/assets/icon.png",
		"category": "Graphics"
	},
	"nsis": {
		"oneClick": false,
		"perMachine": false,
		"allowToChangeInstallationDirectory": true,
		"deleteAppDataOnUninstall": false
	}
}
