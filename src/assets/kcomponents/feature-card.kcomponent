manifest:
  name: "Feature Card"
  author: "Karbonized"
  description: "An icon in a tinted tile, a title and one line of copy: the building block of feature grids and launch posts. Pick the icon from the properties panel."
  version: "1.0.0"
  category: "Marketing"
  width: 420
  height: 250
  tags:
    - "feature"
    - "icon"
    - "card"
    - "starter"

html: |
  <div class="card">
    <span class="badge">
      <span class="k-icon icon"></span>
    </span>
    <p class="title">Lightning fast</p>
    <p class="copy">Renders every frame on the GPU, so big canvases stay smooth.</p>
  </div>

css: |
  :root {
    /* @type:icon */
    --icon: FaBolt;
    /* @type:color */
    --bg: #111318;
    /* @type:color */
    --border: #262a33;
    /* @type:color */
    --text: #f3f4f6;
    /* @type:color */
    --muted: #9aa3b2;
    /* @type:color */
    --accent: #f43f5e;
    /* @type:number min:24 max:64 step:1 unit:px */
    --icon-size: 30px;
    /* @type:number min:0 max:32 step:1 unit:px */
    --radius: 20px;
    /* @type:number min:16 max:48 step:1 unit:px */
    --padding: 28px;
    /* @type:shadow */
    --shadow: #00000066 0px 24px 48px 0px;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--padding);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow);
    color: var(--text);
    font-family: 'Geist Variable', 'Noto Sans Variable', system-ui, sans-serif;
  }

  .badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(var(--icon-size) * 1.9);
    height: calc(var(--icon-size) * 1.9);
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  .icon {
    --k-icon: var(--icon);
    font-size: var(--icon-size);
  }

  .title {
    margin: 20px 0 0 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .copy {
    margin: 8px 0 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
